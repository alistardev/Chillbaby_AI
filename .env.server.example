# Ubuntu VPS — slow CPU, no GPU
#   cp .env.server.example .env
#
# Realistic on 4 vCPU CPU-only: food ~1.5–3s after slide change, emotion ~1–2s.
# See docs/server-performance-and-upgrade.md for client + upgrade guidance.
#
# Max speed on THIS box (trade-off: slightly lower accuracy):
#   FOOD_PROVIDER=local
#   CLARIFAI_WHEN_LOCAL_EMPTY=never
#   LOCAL_FOOD_PREDICT_IMGSZ=256
#   FOOD_CANVAS_MAX_DIM=448
#   LOCAL_FOOD_COCO_FALLBACK_PATH=yolov8n.pt

CAMMY_PROFILE=server

# ── Database ────────────────────────────────────────────────────────────────
DB_URL=mongodb://localhost:27017/

# ── Clarifai ────────────────────────────────────────────────────────────────
FOOD_API_KEY=c3edb07b98a8466d8bcded7c7b66054d
FOOD_API_KEY_2=1d7c78bb339549928c757e6fb79a5a88
MODEL_ID=general-image-recognition
MODEL_VERSION_ID=
CLARIFAI_USER_ID=clarifai
CLARIFAI_APP_ID=main
CLARIFAI_MIN_CONFIDENCE=0.35

OPENAI_API_KEY=

# ── Food detection ────────────────────────────────────────────────────────
FOOD_PROVIDER=local
CLARIFAI_MERGE_EVERY_FRAME=0
CLARIFAI_MIN_INTERVAL_S=5
CLARIFAI_WHEN_LOCAL_EMPTY=never
CLARIFAI_EMPTY_INTERVAL_S=15
CLARIFAI_SKIP_IF_LOCAL_CONF=0.40
FOOD_CAPTURE_INTERVAL_S=1.0
FOOD_CAPTURE_CHANGE_MIN_S=0.45
LOCAL_FOOD_MODEL_PATH=models/food/food_detector.pt
LOCAL_FOOD_COCO_FALLBACK_PATH=yolov8m.pt
YOLO_MODEL_PATH=yolov8n.pt
LOCAL_FOOD_COCO_MERGE_ON_MISS=1
LOCAL_FOOD_COCO_ALWAYS_MERGE=0
LOCAL_FOOD_CONFIDENCE=0.12
LOCAL_FOOD_COCO_CONFIDENCE=0.12
LOCAL_FOOD_PREDICT_IMGSZ=320
LOCAL_FOOD_UPSCALE_MAX_DIM=480
LOCAL_FOOD_DEVICE=cpu
FOOD_MIN_CONFIDENCE=0.12
FOOD_MIN_INTERVAL_S=0.5
FOOD_CLEAR_DEBOUNCE_S=1.0
STREAM_FOOD_FROM_VIDEO=0
FOOD_CANVAS_MAX_DIM=512

# ── Emotion ───────────────────────────────────────────────────────────────
EMOTION_INTERVAL_S=1.0
FER_MAX_DIM=320
FER_USE_MTCNN=0
FOOD_SESSION_BOOT_DELAY_S=2
EMOTION_BOOTSTRAP_S=2
YOLO_DETECT_EVERY_N=30

# ── Nutrition & app ───────────────────────────────────────────────────────
NUTRITION_PROVIDER=auto
CAMMY_ENABLE_NEW_COLLECTION_WRITES=1
CAMMY_AUTO_SYNC_FOOD_MODEL=1
CAMMY_SKIP_PANN_WARMUP=0
CAMMY_SKIP_ML_WARMUP=0
CAMMY_COOKIE_SECURE=1
CAMMY_CONSENT_VERSION=2026-01
CAMMY_ADMIN_USERNAME=admin
CAMMY_ADMIN_PASSWORD=admin123!@#

# ── Audio / PANNs ─────────────────────────────────────────────────────────
PANN_HOP_FRACTION=0.60
PANN_QUEUE_MAXSIZE=12
PANN_QUEUE_HIGH_WATERMARK=0.7
