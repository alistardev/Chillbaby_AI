# Chill Baby AI — full environment reference
#
# Copy to .env and fill in your keys:
#   cp .env.example .env
#
# Runtime profile (optional — sets CPU-friendly defaults when vars below are omitted):
#   CAMMY_PROFILE=local   → Windows / faster dev PC
#   CAMMY_PROFILE=server  → Ubuntu VPS, no GPU, slow CPU
#   CAMMY_PROFILE=auto    → local if CUDA, else server
#
# Shortcuts: .env.local.example or .env.server.example (pre-tuned copies)
# Any explicit value in .env ALWAYS overrides the profile preset.

# ── Profile ─────────────────────────────────────────────────────────────────
CAMMY_PROFILE=local

# ── Database ────────────────────────────────────────────────────────────────
DB_URL=mongodb://localhost:27017/

# ── Clarifai (optional — local YOLO runs without keys) ──────────────────────
FOOD_API_KEY=
FOOD_API_KEY_2=
MODEL_ID=general-image-recognition
MODEL_VERSION_ID=
# general-image-recognition is on Clarifai's public app (not your custom app)
CLARIFAI_USER_ID=clarifai
CLARIFAI_APP_ID=main
CLARIFAI_MIN_CONFIDENCE=0.35

# ── Azure OpenAI (nutrition) ────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Food detection mode ─────────────────────────────────────────────────────
# local = YOLO only · auto = local first, Clarifai when empty/weak · api = more Clarifai
FOOD_PROVIDER=auto
CLARIFAI_FALLBACK_ONLY=1
# 0 = emit local YOLO first; skip Clarifai when local finds food (recommended)
CLARIFAI_MERGE_EVERY_FRAME=0
CLARIFAI_SKIP_IF_LOCAL_CONF=0.40
# local: 3 · server profile: 5
CLARIFAI_MIN_INTERVAL_S=3
CLARIFAI_MISS_CACHE_TTL_S=300
# person = Clarifai when local+COCO miss but person in frame · never | always
CLARIFAI_WHEN_LOCAL_EMPTY=person
# local: 8 · server profile: 15
CLARIFAI_EMPTY_INTERVAL_S=12
CLARIFAI_EMPTY_MISS_CACHE_TTL_S=90

# Local YOLO — paths relative to repo root
LOCAL_FOOD_MODEL_PATH=models/food/food_detector.pt
LOCAL_FOOD_MODEL_FALLBACK_PATH=
LOCAL_FOOD_COCO_FALLBACK_PATH=yolov8m.pt
YOLO_MODEL_PATH=yolov8n.pt
LOCAL_FOOD_COCO_MERGE_ON_MISS=1
LOCAL_FOOD_COCO_ALWAYS_MERGE=0
LOCAL_FOOD_TRUST_CUSTOM=0.35
LOCAL_FOOD_CONFIDENCE=0.12
LOCAL_FOOD_COCO_CONFIDENCE=0.12
LOCAL_FOOD_COCO_PREDICT_CONF=0.12
LOCAL_FOOD_WEAK_MIN=0.06
# local profile: 384 · server profile: 320
LOCAL_FOOD_PREDICT_IMGSZ=384
# local profile: 640 · server profile: 480
LOCAL_FOOD_UPSCALE_MAX_DIM=640
# empty = auto (CUDA if available else cpu) · server profile sets cpu
LOCAL_FOOD_DEVICE=
LOCAL_FOOD_TOPK=5
FOOD_MIN_CONFIDENCE=0.12
# local profile: 0.5 · server profile: 1.0
FOOD_MIN_INTERVAL_S=0.5
FOOD_CLEAR_DEBOUNCE_S=1.0
LOCAL_LABEL_HOLD_S=5.0
# Browser canvas interval (seconds) — local: 0.8 · server: 1.0
FOOD_CAPTURE_INTERVAL_S=0.8
# Send sooner when slide/scene changes (seconds) — server: 0.45
FOOD_CAPTURE_CHANGE_MIN_S=0.45
# 0 = food from browser canvas (recommended). 1 = also YOLO on WebRTC stream (heavier).
STREAM_FOOD_FROM_VIDEO=0
# local profile: 720 · server profile: 512
FOOD_CANVAS_MAX_DIM=720
FOOD_WEBRTC_MAX_WIDTH=960

# ── Emotion (FER on WebRTC) ─────────────────────────────────────────────────
# local profile: 0.5 · server profile: 1.0 (after each FER run completes)
EMOTION_INTERVAL_S=0.5
# local profile: 480 · server profile: 320
FER_MAX_DIM=480
# 0 = faster on CPU (server default). 1 = better face find, much slower on CPU.
FER_USE_MTCNN=0
# Seconds to defer food YOLO after session start (FER gets CPU first)
# local: 5 · server: 12
FOOD_SESSION_BOOT_DELAY_S=2
# Food/child defer until first emotion — local: 8 · server: 12
EMOTION_BOOTSTRAP_S=2
# Child YOLO every N WebRTC frames — local: 15 · server: 30
YOLO_DETECT_EVERY_N=15

# ── Nutrition ───────────────────────────────────────────────────────────────
# auto = Azure if OPENAI_API_KEY set, else local JSON (data/nutrition_lookup.json)
NUTRITION_PROVIDER=auto

# ── Allergen alerts ─────────────────────────────────────────────────────────
ALLERGEN_ALERT_COOLDOWN_S=8.0

# ── App behavior flags ──────────────────────────────────────────────────────
CAMMY_AUTO_SYNC_FOOD_MODEL=1
CAMMY_ENABLE_NEW_COLLECTION_WRITES=1
# local profile: 1 (skip on dev restart) · server profile: 0 (warm at startup)
CAMMY_SKIP_PANN_WARMUP=1
# server profile: 0 (warm food+FER+child at startup)
CAMMY_SKIP_ML_WARMUP=0
CAMMY_LOG_ASYNCIO_RESET=0

# Session cookie: set 0 for plain HTTP local dev (no TLS). Production HTTPS should leave 1.
CAMMY_COOKIE_SECURE=1

# Beta consent text version (stored on tester + session records when checkbox is accepted).
CAMMY_CONSENT_VERSION=2026-01

# Admin dashboard login (required to open /dashboard and sensitive APIs).
CAMMY_ADMIN_USERNAME=admin
CAMMY_ADMIN_PASSWORD=admin123!@#

# ── Audio / PANNs (cough / sneeze) ──────────────────────────────────────────
PANN_INPUT_GAIN=1.42
PANN_HOP_FRACTION=0.60
PANN_QUEUE_MAXSIZE=12
PANN_QUEUE_HIGH_WATERMARK=0.7
PANN_WINDOW_PEAK_GATE=0.065
PANN_WINDOW_PEAK_TARGET=0.32

# ── Optional (not wired in main food path) ──────────────────────────────────
FOODVISOR_API=
