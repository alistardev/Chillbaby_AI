# ── Database ────────────────────────────────────────────────────────────────
DB_URL=mongodb://localhost:27017/

# ── Optional API providers ──────────────────────────────────────────────────
# Demo: Clarifai general-image-recognition + local YOLO. Production: leave blank, FOOD_PROVIDER=local
FOOD_API_KEY=
MODEL_ID=general-image-recognition
CLARIFAI_USER_ID=clarifai
CLARIFAI_APP_ID=main
CLARIFAI_MIN_CONFIDENCE=0.75
OPENAI_API_KEY=

# Nutrition: auto = Azure if OPENAI_API_KEY set, else local JSON (data/nutrition_lookup.json)
# azure | local | none
NUTRITION_PROVIDER=auto

# ── Food detection mode ─────────────────────────────────────────────────────
# local  = YOLO only (default — no Clarifai calls)
# auto   = local first; Clarifai only when local empty/weak (keeps free-tier credits)
# api    = may call Clarifai more often; local still runs first unless you set CLARIFAI_FALLBACK_ONLY=0
# auto = local YOLO + COCO merge + Clarifai every ~3s (cammy-style, best for demos)
FOOD_PROVIDER=auto
CLARIFAI_FALLBACK_ONLY=1
CLARIFAI_MERGE_EVERY_FRAME=1
CLARIFAI_SKIP_IF_LOCAL_CONF=0.12
CLARIFAI_MIN_INTERVAL_S=1
FOOD_CAPTURE_INTERVAL_S=1

# Local YOLO — paths relative to repo root
LOCAL_FOOD_MODEL_PATH=models/food/food_detector.pt
LOCAL_FOOD_MODEL_FALLBACK_PATH=
# COCO fallback when custom model finds nothing (yolov8m.pt auto-downloads via Ultralytics)
LOCAL_FOOD_COCO_FALLBACK_PATH=yolov8m.pt
LOCAL_FOOD_COCO_MERGE_ON_MISS=1
LOCAL_FOOD_COCO_ALWAYS_MERGE=0
LOCAL_FOOD_TRUST_CUSTOM=0.35
LOCAL_FOOD_CONFIDENCE=0.12
LOCAL_FOOD_COCO_CONFIDENCE=0.35
LOCAL_FOOD_PREDICT_IMGSZ=512
LOCAL_FOOD_UPSCALE_MAX_DIM=720
# empty = auto (CUDA if available else cpu)
LOCAL_FOOD_DEVICE=
FOOD_MIN_CONFIDENCE=0.12
FOOD_MIN_INTERVAL_S=2.0
FOOD_CLEAR_DEBOUNCE_S=1.0
FOOD_CAPTURE_INTERVAL_S=1.5
# 0 = food from browser canvas (full frame, low CPU). 1 = also run YOLO on WebRTC (heavier).
STREAM_FOOD_FROM_VIDEO=0
FOOD_CANVAS_MAX_DIM=720

# ── App behavior flags ──────────────────────────────────────────────────────
CAMMY_AUTO_SYNC_FOOD_MODEL=1
CAMMY_ENABLE_NEW_COLLECTION_WRITES=1
CAMMY_SKIP_PANN_WARMUP=1
CAMMY_LOG_ASYNCIO_RESET=0

# ── Audio tuning (optional) ─────────────────────────────────────────────────
PANN_INPUT_GAIN=1.42
PANN_HOP_FRACTION=0.60
PANN_QUEUE_MAXSIZE=12
PANN_QUEUE_HIGH_WATERMARK=0.7
PANN_WINDOW_PEAK_GATE=0.065
PANN_WINDOW_PEAK_TARGET=0.32
